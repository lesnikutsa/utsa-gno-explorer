[Unit]
Description=Refresh UTSA Gno Explorer Realm catalog every three hours
Documentation=file:/opt/utsa-gno-explorer/docs/production-deployment.md

[Timer]
OnCalendar=*-*-* 00,03,06,09,12,15,18,21:00:00 UTC
Persistent=true
RandomizedDelaySec=5m
AccuracySec=1m
Unit=utsa-gno-realm-catalog-refresh.service

[Install]
WantedBy=timers.target
